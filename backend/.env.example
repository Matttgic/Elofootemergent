# Copier en backend/.env (jamais commité) — en production, ces valeurs vont dans
# les variables d'environnement de Render et les secrets GitHub Actions.
MONGO_URL=mongodb://localhost:27017
DB_NAME=footpulse
FOOTBALL_DATA_TOKEN=
# Optionnel : cotes réelles pour la simulation de paris (the-odds-api.com)
ODDS_API_KEY=
# Optionnel : codes séparés par des virgules (défaut : les 12 compétitions gratuites)
COMPETITIONS=
# Optionnel : origines autorisées, ex. https://footpulse.vercel.app (défaut : *)
CORS_ORIGINS=
# false sur un hébergement qui se met en veille (synchros via GitHub Actions)
SCHEDULER_ENABLED=true
